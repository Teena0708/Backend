<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
     <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 text-white">
        <h3>Create User</h3>
        <form method="post" action="/create">
            <input class="px-3 py-2 rounded-md bg-transparent" type="text" name="username" placeholder="Username">
            <input class="px-3 py-2 rounded-md bg-transparent" type="password" name="password" placeholder="Password">
            <input class="px-3 py-2 rounded-md bg-transparent" type="email" name="email" placeholder="Email">
            <input class="px-3 py-2 rounded-md bg-transparent" type = "number" name="age" placeholder="Age">
            <input class="px-5 py-2 rounded-md bg-blue-500" type ="submit" value="Create User">
            
        </form>
    </div>
</body>
</html>